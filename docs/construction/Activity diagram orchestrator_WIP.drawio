etry"><Array as="points"><mxPoint x="355" y="165"/><mxPoint x="1070" y="165"/></Array></mxGeometry></mxCell><mxCell id="edge36" value="notify cv" style="html=1;rounded=0;jumpStyle=arc;jumpSize=10;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#b85450;strokeWidth=2;fontColor=#b85450;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c5" target="d1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="955" y="555"/><mxPoint x="955" y="235"/></Array></mxGeometry></mxCell><mxCell id="edge37" value="notify cv_sound_TDOA" style="html=1;rounded=0;jumpStyle=arc;jumpSize=10;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#b85450;strokeWidth=2;fontColor=#b85450;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="d7" target="t5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="955" y="715"/><mxPoint x="955" y="960"/><mxPoint x="415" y="960"/><mxPoint x="415" y="565"/></Array></mxGeometry></mxCell><mxCell id="edge38" value="starter tråd" style="html=1;rounded=0;jumpStyle=arc;jumpSize=10;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;edgeStyle=orthogonalEdgeStyle;dashed=1;dashPattern=8 4;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#6c8ebf;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="ev" target="e1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="320" y="1000"/><mxPoint x="1215" y="1000"/><mxPoint x="1215" y="235"/></Array></mxGeometry></mxCell><mxCell id="edge39" value="pipe: plot" style="html=1;rounded=0;jumpStyle=arc;jumpSize=10;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#9673a6;strokeWidth=2;fontColor=#9673a6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="e1" target="p2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1452" y="235"/><mxPoint x="1452" y="1050"/><mxPoint x="665" y="1050"/><mxPoint x="665" y="595"/></Array></mxGeometry></mxCell><mxCell id="edge40" value="pipe: slet" style="html=1;rounded=0;jumpStyle=arc;jumpSize=10;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#9673a6;strokeWidth=2;fontColor=#9673a6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="e3" target="p2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1445" y="395"/><mxPoint x="1445" y="1025"/><mxPoint x="670" y="1025"/><mxPoint x="670" y="615"/></Array></mxGeometry></mxCell><mxCell id="q1_c3" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e51400;strokeColor=#b20000;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="896" y="362" width="24" height="24" as="geometry"/></mxCell><mxCell id="q2_c1" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e51400;strokeColor=#b20000;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="896" y="202" width="24" height="24" as="geometry"/></mxCell><mxCell id="q3_d1" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e51400;strokeColor=#b20000;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1156" y="202" width="24" height="24" as="geometry"/></mxCell><mxCell id="q4_c5" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e51400;strokeColor=#b20000;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="896" y="522" width="24" height="24" as="geometry"/></mxCell><mxCell id="q5_d4" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e51400;strokeColor=#b20000;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1156" y="442" width="24" height="24" as="geometry"/></mxCell><mxCell id="q6_d5" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e51400;strokeColor=#b20000;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1156" y="522" width="24" height="24" as="geometry"/></mxCell><mxCell id="q7_t5" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e51400;strokeColor=#b20000;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="316" y="542" width="24" height="24" as="geometry"/></mxCell><mxCell id="q8_e1" value="8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e51400;strokeColor=#b20000;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1416" y="202" width="24" height="24" as="geometry"/></mxCell><mxCell id="q9_u2" value="9" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e51400;strokeColor=#b20000;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="206" y="782" width="24" height="24" as="geometry"/></mxCell><mxCell id="q10_t4" value="10" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e51400;strokeColor=#b20000;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="316" y="442" width="24" height="24" as="geometry"/></mxCell><mxCell id="postit" value="&lt;b style='font-size:14px'&gt;Åbne spørgsmål til logikken&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1.&lt;/b&gt; TCP holder event lock under »Afvent TCP-besked«. recv blokerer, så TDOA kan ikke få låsen, før der kommer en besked. Tag låsen efter modtagelsen, kun omkring »Push til kø«.&lt;br&gt;&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; Orchestratorens TCP-tråd har en forbindelse åben til hver mikrofonnode. Hvordan venter én tråd på flere sockets? (poll/select, eller én tråd pr. forbindelse)&lt;br&gt;&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; TDOA venter på cv, før den tager en lås. cv.wait skal kaldes med event lock holdt og et prædikat (»køen er ikke tom«), ellers kan en notify gå tabt. TDOA mangler også at tage event lock og hente beskeden ud af køen.&lt;br&gt;&lt;br&gt;&lt;b&gt;4.&lt;/b&gt; TCP notifier for hver besked, men én beregning kræver NODE_EVENT fra begge noder. Hvem parrer dem til samme lydhændelse, og hvad sker der, hvis kun én node sender (timeout)?&lt;br&gt;&lt;br&gt;&lt;b&gt;5.&lt;/b&gt; TDOA holder data lock under hele beregningen. Imens kan bruger-input ikke opdatere mic pos. Kopiér mic pos, slip låsen og beregn bagefter.&lt;br&gt;&lt;br&gt;&lt;b&gt;6.&lt;/b&gt; »Set sound event«: Hvor gemmes resultatet, og under hvilken lås læser TUI det? Kommer to resultater lige efter hinanden, overskrives det første, fordi en cv ikke er en kø.&lt;br&gt;&lt;br&gt;&lt;b&gt;7.&lt;/b&gt; Fælles await: en condition_variable kan ikke vente på stdin. Fx en input-tråd, der lægger input i samme kø/cv som lydhændelserne, eller poll() på stdin + en eventfd.&lt;br&gt;&lt;br&gt;&lt;b&gt;8.&lt;/b&gt; Én TUI/Event-tråd pr. event: Hvem joiner/detacher dem? Flere tråde skriver i samme pipe og skal serialiseres (lås). »Delete event« skal angive hvilket event (ID).&lt;br&gt;&lt;br&gt;&lt;b&gt;9.&lt;/b&gt; Når mic pos ændres via bruger-input, får Plot ikke besked. »Plot mics« kører kun ved start.&lt;br&gt;&lt;br&gt;&lt;b&gt;10.&lt;/b&gt; Ingen nedlukning: Hvordan stoppes løkkerne, og hvordan joines trådene?" style="shape=note;whiteSpace=wrap;html=1;size=18;align=left;verticalAlign=top;spacing=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;shadow=1;" vertex="1" parent="1"><mxGeometry x="1500" y="100" width="440" height="860" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Forklaring&lt;/b&gt;&lt;br&gt;&lt;span style='background:#dae8fc'&gt;&amp;nbsp;blå&amp;nbsp;&lt;/span&gt; lock / release&amp;nbsp;&amp;nbsp; &lt;span style='background:#fff2cc'&gt;&amp;nbsp;gul&amp;nbsp;&lt;/span&gt; blokerende vent&amp;nbsp;&amp;nbsp; &lt;span style='background:#d5e8d4'&gt;&amp;nbsp;grøn&amp;nbsp;&lt;/span&gt; notify&amp;nbsp;&amp;nbsp; &lt;span style='background:#e1d5e7'&gt;&amp;nbsp;lilla&amp;nbsp;&lt;/span&gt; skriv til pipe&lt;br&gt;&lt;font color='#b85450'&gt;rød stiplet&lt;/font&gt; = condition variable&amp;nbsp;&amp;nbsp; &lt;font color='#6c8ebf'&gt;blå stiplet&lt;/font&gt; = starter tråd (fra fork-bjælken: Plot, TCP og TDOA)&amp;nbsp;&amp;nbsp; &lt;font color='#9673a6'&gt;lilla stiplet&lt;/font&gt; = pipe til Python&amp;nbsp;&amp;nbsp; sort bjælke = fork&lt;br&gt;Låse: &lt;b&gt;data lock&lt;/b&gt; beskytter den delte datacontainer med mic pos. &lt;b&gt;event lock&lt;/b&gt; beskytter køen mellem TCP og TDOA.&lt;br&gt;Antaget, ikke afklaret: TCP- og Plot-løkkerne er tegnet ud fra, at systemet kører for evigt; Plot-banen er Python-modulet og startes af Init." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="1100" width="1420" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>