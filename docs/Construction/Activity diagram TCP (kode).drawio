<mxfile host="app.diagrams.net"><diagram id="tcp-code" name="TCP (som koden er nu)"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="780" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ttl" value="&lt;b&gt;Activity diagram – TCP i orchestratoren (som koden er nu)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;orchestrator_tcp.cpp og common/event_queue.h på branch tcp, 20-11-2026. Én accept-tråd og én modtager-tråd pr. node (max 2).&lt;/font&gt;" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1200" height="56" as="geometry"/></mxCell><mxCell id="laneA" value="Accept-tråd · start()" style="swimlane;startSize=40;fontStyle=1;fontSize=16;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#ffffff;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="380" height="600" as="geometry"/></mxCell><mxCell id="laneR" value="Modtager-tråd · receiveLoop · én pr. node" style="swimlane;startSize=40;fontStyle=1;fontSize=16;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#ffffff;html=1;" vertex="1" parent="1"><mxGeometry x="420" y="80" width="440" height="600" as="geometry"/></mxCell><mxCell id="a0" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="215" y="130" width="30" height="30" as="geometry"/></mxCell><mxCell id="a1" value="&lt;b&gt;Setup&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style='font-size:11px'&gt;socket, bind, listen(2)&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="120" y="180" width="220" height="56" as="geometry"/></mxCell><mxCell id="a2" value="&lt;b&gt;accept()&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style='font-size:11px'&gt;blokerer, til en node forbinder&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="120" y="270" width="220" height="56" as="geometry"/></mxCell><mxCell id="ad" value="" style="rhombus;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="205" y="360" width="50" height="50" as="geometry"/></mxCell><mxCell id="a3" value="&lt;b&gt;Start modtager-tråd&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style='font-size:11px'&gt;join gammel tråd, std::thread(receiveLoop, fd, i)&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="120" y="450" width="220" height="60" as="geometry"/></mxCell><mxCell id="e1" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;jumpStyle=arc;endArrow=open;endSize=10;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;strokeColor=#333333;" edge="1" parent="1" source="a0" target="a1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;jumpStyle=arc;endArrow=open;endSize=10;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;strokeColor=#333333;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;jumpStyle=arc;endArrow=open;endSize=10;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;strokeColor=#333333;" edge="1" parent="1" source="a2" target="ad"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="[ledig plads]" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;jumpStyle=arc;endArrow=open;endSize=10;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;strokeColor=#333333;" edge="1" parent="1" source="ad" target="a3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="[ingen plads: close(fd)]" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;jumpStyle=arc;endArrow=open;endSize=10;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;strokeColor=#333333;" edge="1" parent="1" source="ad" target="a2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="370" y="385"/><mxPoint x="370" y="298"/></Array></mxGeometry></mxCell><mxCell id="e6" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;jumpStyle=arc;endArrow=open;endSize=10;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;strokeColor=#333333;" edge="1" parent="1" source="a3" target="a2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="80" y="480"/><mxPoint x="80" y="298"/></Array></mxGeometry></mxCell><mxCell id="r0" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="625" y="130" width="30" height="30" as="geometry"/></mxCell><mxCell id="r1" value="&lt;b&gt;recieveJson()&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style='font-size:11px'&gt;recv() indtil der er en hel linje (\n)&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="520" y="180" width="240" height="60" as="geometry"/></mxCell><mxCell id="rd" value="" style="rhombus;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="615" y="280" width="50" height="50" as="geometry"/></mxCell><mxCell id="r2" value="&lt;b&gt;jsonToStruct + pushToQueue&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style='font-size:11px'&gt;ugyldig JSON springes over · push → notify&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="520" y="370" width="240" height="60" as="geometry"/></mxCell><mxCell id="r3" value="&lt;b&gt;close(fd), done_[i] = true&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style='font-size:11px'&gt;pladsen er ledig igen&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="520" y="480" width="240" height="56" as="geometry"/></mxCell><mxCell id="rf" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="625" y="570" width="30" height="30" as="geometry"/></mxCell><mxCell id="e7" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;jumpStyle=arc;endArrow=open;endSize=10;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;strokeColor=#333333;" edge="1" parent="1" source="r0" target="r1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;jumpStyle=arc;endArrow=open;endSize=10;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;strokeColor=#333333;" edge="1" parent="1" source="r1" target="rd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="[linje modtaget]" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;jumpStyle=arc;endArrow=open;endSize=10;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;strokeColor=#333333;" edge="1" parent="1" source="rd" target="r2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="[node lukket / recv-fejl]" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;jumpStyle=arc;endArrow=open;endSize=10;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="rd" target="r3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800" y="305"/><mxPoint x="800" y="508"/></Array></mxGeometry></mxCell><mxCell id="e11" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;jumpStyle=arc;endArrow=open;endSize=10;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;strokeColor=#333333;" edge="1" parent="1" source="r2" target="r1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="490" y="400"/><mxPoint x="490" y="210"/></Array></mxGeometry></mxCell><mxCell id="e12" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;jumpStyle=arc;endArrow=open;endSize=10;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;strokeColor=#333333;" edge="1" parent="1" source="r3" target="rf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="starter tråd" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;jumpStyle=arc;endArrow=open;endSize=10;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;dashed=1;dashPattern=8 4;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#6c8ebf;" edge="1" parent="1" source="a3" target="r0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="480"/><mxPoint x="400" y="110"/><mxPoint x="640" y="110"/></Array></mxGeometry></mxCell><mxCell id="tdoa" value="&lt;b&gt;TDOA&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style='font-size:11px'&gt;queue.pop(stop_token)&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fontSize=13;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#444441;" vertex="1" parent="1"><mxGeometry x="900" y="250" width="200" height="56" as="geometry"/></mxCell><mxCell id="q" value="&lt;b&gt;EventQueue&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style='font-size:11px'&gt;[mutex_ · cv_] · max 64, fuld → ældste smides&lt;/font&gt;&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#085041;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="900" y="370" width="200" height="70" as="geometry"/></mxCell><mxCell id="e14" value="push" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;jumpStyle=arc;endArrow=open;endSize=10;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;strokeColor=#0F6E56;strokeWidth=1.5;fontColor=#085041;" edge="1" parent="1" source="r2" target="q"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="pop" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;jumpStyle=arc;endArrow=open;endSize=10;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;strokeColor=#0F6E56;strokeWidth=1.5;fontColor=#085041;" edge="1" parent="1" source="q" target="tdoa"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="note" value="&lt;b&gt;Afvigelser fra activity diagram v4&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Én modtager-tråd pr. node i stedet for én TCP-tråd med poll().&lt;br&gt;2. Ingen parring: hvert event pushes for sig.&lt;br&gt;3. Ingen nedlukning: accept() og recv() blokerer og reagerer ikke på stop_token.&lt;br&gt;4. Fuld kø (64) smider det ældste event væk." style="shape=note;whiteSpace=wrap;html=1;size=18;align=left;verticalAlign=top;spacing=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="480" width="300" height="170" as="geometry"/></mxCell><mxCell id="leg" value="&lt;b&gt;Forklaring:&lt;/b&gt; gul = blokerende vent · grøn = skriver til køen og notify'er · rød = fejlvej · blå stiplet = starter tråd · grøn firkant = delte data · kursiv linje = hvad trinnet gør i koden." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="1160" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>