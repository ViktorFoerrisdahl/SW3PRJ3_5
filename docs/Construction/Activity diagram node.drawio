<mxfile host="app.diagrams.net"><diagram id="node-threads" name="Node tråde (forslag)"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2240" pageHeight="1460" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane_main" value="Main" style="swimlane;startSize=40;fontStyle=1;fontSize=16;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#ffffff;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="280" height="1280" as="geometry"/></mxCell><mxCell id="lane_cap" value="Capture-tråd · AlsaCapture::run" style="swimlane;startSize=40;fontStyle=1;fontSize=16;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#ffffff;html=1;" vertex="1" parent="1"><mxGeometry x="320" y="90" width="400" height="1280" as="geometry"/></mxCell><mxCell id="lane_det" value="Detektor-tråd · EventDetector::run" style="swimlane;startSize=40;fontStyle=1;fontSize=16;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#ffffff;html=1;" vertex="1" parent="1"><mxGeometry x="880" y="90" width="400" height="1280" as="geometry"/></mxCell><mxCell id="lane_tcp" value="TCP-tråd · NodeTCP::senderLoop" style="swimlane;startSize=40;fontStyle=1;fontSize=16;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#ffffff;html=1;" vertex="1" parent="1"><mxGeometry x="1440" y="90" width="400" height="1280" as="geometry"/></mxCell><mxCell id="title" value="Activity diagram – Mikrofonnode (forslag)&lt;br&gt;&lt;font style='font-size:12px;font-weight:normal'&gt;Tre tråde + main. Tråde og delte data som i koden på branch tcp (20-11-2026); main findes ikke endnu og er et forslag. Capture og netværk er adskilt, så send()/connect() aldrig kan få ALSA til at løbe over (bufferen er ca. 43 ms).&lt;/font&gt;" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1800" height="70" as="geometry"/></mxCell><mxCell id="m0" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="165" y="130" width="30" height="30" as="geometry"/></mxCell><mxCell id="m_cfg" value='&lt;b&gt;Læs konfiguration&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px"&gt;node_id, orchestrator IP:port, ALSA-device, tærskler&lt;/font&gt;&lt;/i&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="70" y="180" width="220" height="60" as="geometry"/></mxCell><mxCell id="m_ptp" value='&lt;b&gt;PtpService::start()&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px"&gt;ptp4l + phc2sys via systemd&lt;/font&gt;&lt;/i&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="70" y="270" width="220" height="56" as="geometry"/></mxCell><mxCell id="m_sync" value='&lt;b&gt;Vent på PTP-sync&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px"&gt;readOffsetBudgetNs() hvert 1 s, til offset ≤ 200 µs&lt;/font&gt;&lt;/i&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="70" y="356" width="220" height="60" as="geometry"/></mxCell><mxCell id="m_mk" value='&lt;b&gt;Opret RingBuffer og EventQueue&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px"&gt;ca. 2,7 s frames · højst 16 events&lt;/font&gt;&lt;/i&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="70" y="446" width="220" height="56" as="geometry"/></mxCell><mxCell id="m_open" value='&lt;b&gt;AlsaCapture::open()&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px"&gt;S32_LE, 2 kanaler, 48 kHz&lt;/font&gt;&lt;/i&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="70" y="532" width="220" height="56" as="geometry"/></mxCell><mxCell id="m_dopen" value="" style="rhombus;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="155" y="615" width="50" height="50" as="geometry"/></mxCell><mxCell id="m_ferr" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="50" y="685" width="30" height="30" as="geometry"/></mxCell><mxCell id="fork" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="100" y="725" width="1730" height="8" as="geometry"/></mxCell><mxCell id="m_sig" value='&lt;b&gt;Vent på SIGINT / SIGTERM&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px"&gt;sigwait()&lt;/font&gt;&lt;/i&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="70" y="770" width="220" height="60" as="geometry"/></mxCell><mxCell id="m_stop" value='&lt;b&gt;Stop trådene&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px"&gt;request_stop() på alle tre, derefter join() – venter til de er færdige&lt;/font&gt;&lt;/i&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="70" y="860" width="220" height="70" as="geometry"/></mxCell><mxCell id="m_ptpstop" value="&lt;b&gt;PtpService::stop()&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="70" y="960" width="220" height="56" as="geometry"/></mxCell><mxCell id="m_fin" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="165" y="1046" width="30" height="30" as="geometry"/></mxCell><mxCell id="c_m" value="" style="rhombus;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="475" y="760" width="30" height="30" as="geometry"/></mxCell><mxCell id="c_read" value='&lt;b&gt;snd_pcm_readi()&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px"&gt;blokerer, til 512 frames er optaget (~10,7 ms)&lt;/font&gt;&lt;/i&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="380" y="810" width="220" height="60" as="geometry"/></mxCell><mxCell id="c_d1" value="" style="rhombus;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="465" y="900" width="50" height="50" as="geometry"/></mxCell><mxCell id="c_ovr" value='&lt;b&gt;Overrun&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px"&gt;snd_pcm_recover() + resetTimeAnchors()&lt;/font&gt;&lt;/i&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="617" y="890" width="96" height="70" as="geometry"/></mxCell><mxCell id="c_write" value="&lt;b&gt;rb.write(period)&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:11px&quot;&gt;skriver frames og notify'er (cv_)&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="380" y="985" width="220" height="56" as="geometry"/></mxCell><mxCell id="c_anchor" value='&lt;b&gt;RecordTimeAnchor()&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px"&gt;htstamp + avail → addTimeAnchor()&lt;/font&gt;&lt;/i&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="380" y="1075" width="220" height="56" as="geometry"/></mxCell><mxCell id="c_d2" value="" style="rhombus;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="465" y="1165" width="50" height="50" as="geometry"/></mxCell><mxCell id="c_ff" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="650" y="1175" width="30" height="30" as="geometry"/></mxCell><mxCell id="rb" value='&lt;b&gt;RingBuffer&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px"&gt;[mutex_ · cv_]&lt;br&gt;frames + tidsankre&lt;/font&gt;&lt;/i&gt;' style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#085041;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="730" y="960" width="140" height="270" as="geometry"/></mxCell><mxCell id="d_m" value="" style="rhombus;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1045" y="760" width="30" height="30" as="geometry"/></mxCell><mxCell id="d_wait" value='&lt;b&gt;waitForFrames(read_ + 1, st)&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px"&gt;sover på RingBuffer::cv_&lt;/font&gt;&lt;/i&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="950" y="810" width="220" height="60" as="geometry"/></mxCell><mxCell id="d_d1" value="" style="rhombus;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1035" y="900" width="50" height="50" as="geometry"/></mxCell><mxCell id="d_ff" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="895" y="910" width="30" height="30" as="geometry"/></mxCell><mxCell id="d_proc" value='&lt;b&gt;processAvailable()&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px"&gt;copyFrames (≤ 512) · pr. frame: &amp;gt;&amp;gt;14 → DcRemover → SlidingRms → tilstand&lt;/font&gt;&lt;/i&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="950" y="980" width="220" height="76" as="geometry"/></mxCell><mxCell id="d_d2" value="" style="rhombus;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1035" y="1085" width="50" height="50" as="geometry"/></mxCell><mxCell id="d_ext" value='&lt;b&gt;extractAndSend()&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px"&gt;kopiér [T−15, T+35 ms), timestampNs(), push · holdoff 200 ms&lt;/font&gt;&lt;/i&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="950" y="1165" width="220" height="76" as="geometry"/></mxCell><mxCell id="eq" value='&lt;b&gt;EventQueue&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px"&gt;[mutex_ · cv_]&lt;br&gt;højst 16 · fuld → ældste smides&lt;/font&gt;&lt;/i&gt;' style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#085041;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1290" y="930" width="140" height="110" as="geometry"/></mxCell><mxCell id="t_m1" value="" style="rhombus;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1605" y="760" width="30" height="30" as="geometry"/></mxCell><mxCell id="t_conn" value='&lt;b&gt;connectToOrchestrator()&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px"&gt;ny socket + connect(), prøv igen hvert 1 s&lt;/font&gt;&lt;/i&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1510" y="810" width="220" height="60" as="geometry"/></mxCell><mxCell id="t_m2" value="" style="rhombus;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1605" y="895" width="30" height="30" as="geometry"/></mxCell><mxCell id="t_pop" value='&lt;b&gt;queue.pop(st)&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px"&gt;sover på EventQueue::cv_&lt;/font&gt;&lt;/i&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1510" y="945" width="220" height="60" as="geometry"/></mxCell><mxCell id="t_d1" value="" style="rhombus;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1595" y="1035" width="50" height="50" as="geometry"/></mxCell><mxCell id="t_ff" value="" style="shape=sumEllipse;perimeter=ellipsePerimeter;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1455" y="1045" width="30" height="30" as="geometry"/></mxCell><mxCell id="t_send" value='&lt;b&gt;sendAsJSON()&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px"&gt;JSON + \n · send() til alt er sendt&lt;/font&gt;&lt;/i&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1510" y="1115" width="220" height="60" as="geometry"/></mxCell><mxCell id="t_d2" value="" style="rhombus;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1595" y="1205" width="50" height="50" as="geometry"/></mxCell><mxCell id="t_close" value='&lt;b&gt;close(fd)&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px"&gt;forbindelsen er tabt&lt;/font&gt;&lt;/i&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1510" y="1285" width="220" height="56" as="geometry"/></mxCell><mxCell id="note" value="&lt;b style='font-size:14px'&gt;Åbne punkter&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1.&lt;/b&gt; Main findes ikke i koden endnu. Venstre bane er et forslag.&lt;br&gt;&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; Skal noden vente på PTP-sync før capture? Ellers kan de første events få forkert tid.&lt;br&gt;&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; Fejler snd_pcm_recover(), returnerer capture-tråden false og stopper (ikke tegnet). Main opdager det ikke og venter stadig på et signal.&lt;br&gt;&lt;br&gt;&lt;b&gt;4.&lt;/b&gt; send() kan blokere, hvis orchestratoren ikke læser. Så hænger nedlukningen i join(). Brug SO_SNDTIMEO eller shutdown().&lt;br&gt;&lt;br&gt;&lt;b&gt;5.&lt;/b&gt; Fejler copyFrames() i detektoren, laves resync med ny warmup (ikke tegnet).&lt;br&gt;&lt;br&gt;&lt;b&gt;6.&lt;/b&gt; threshold_raw er ikke fastsat. Detektoren nægter at starte, før den er sat." style="shape=note;whiteSpace=wrap;html=1;size=18;align=left;verticalAlign=top;spacing=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1880" y="90" width="330" height="470" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Forklaring:&lt;/b&gt; gul = blokerende vent · grøn boks = skriver til delte data og notify'er · rød = fejlvej · grøn firkant = delte data med lås i [ ] · grøn pil = data læses/skrives · sort bjælke = fork (main starter trådene som std::jthread) · ⊗ = tråden slutter · lille ruder øverst i hver bane = merge (løkken starter forfra)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1385" width="1800" height="50" as="geometry"/></mxCell><mxCell id="e0" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;jumpStyle=arc;endArrow=open;endSize=10;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="m0" target="m_cfg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;jumpStyle=arc;endArrow=open;endSize=10;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="m_cfg" target="m_ptp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e