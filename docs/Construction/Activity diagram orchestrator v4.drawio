        <mxCell id="q13_u1" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e51400;strokeColor=#b20000;fontColor=#ffffff;fontStyle=1;fontSize=12;" value="13" vertex="1">
